@model LibreriaWeb.Models.Eventos.ViewModelEventoBuscarFecha

@{
    ViewData["Title"] = "Buscar Eventos";
    IEnumerable<LibreriaWeb.Models.Eventos.ViewModelEventoListado> eventos = ViewBag.Eventos;
}

<h1>Buscar Eventos</h1>

<form asp-action="Buscar" method="get">
    <div class="row align-items-center">
        <div class="form-group col-md-6 d-flex align-items-center">
            <label asp-for="Fecha" class="control-label me-2 mb-0"></label>
            <input asp-for="Fecha" class="form-control" type="date" value="@Model.Fecha.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="Fecha" class="text-danger"></span>
        </div>
        <div class="form-group col-md-6">
            <input type="submit" value="Buscar" class="btn btn-primary" />
        </div>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                Id
            </th>
            <th>
                Nombre
            </th>
            <th>
                Disciplina
            </th>
            <th>
                FechaInicio
            </th>
            <th>
                FechaFin
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in eventos)
        {
            <tr>
                <td>
                    <strong>@item.Id</strong>
                </td>
                <td>
                    @item.Nombre
                </td>
                <td>
                    @item.Disciplina.Nombre
                </td>
                <td>
                    @item.FechaInicio
                </td>
                <td>
                    @item.FechaFin
                </td>
                <td>
                    @Html.ActionLink("Ver Participantes", "Participantes", new { id = item.Id })
                </td>
            </tr>
        }
    </tbody>
</table>