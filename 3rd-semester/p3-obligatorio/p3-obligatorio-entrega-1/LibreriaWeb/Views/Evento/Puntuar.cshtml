@using LibreriaWeb.Models.Eventos;
@using LibreriaWeb.Models.Atletas;
@model LibreriaWeb.Models.Eventos.ViewModelAtletaEventoListado

@{
    ViewData["Title"] = "Puntuar Atleta en Evento";
    ViewModelEventoListado evento = ViewBag.Evento;
    ViewModelAtletaListado atleta = ViewBag.Atleta;
}

<h2>Puntuar Atleta (#@atleta.Id) en Evento (#@evento.Id)</h2>

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <h3>Evento</h3>
            <dl class="row">
                <dt class="col-sm-4">
                    Id
                </dt>
                <dd class="col-sm-8">
                    @evento.Id
                </dd>
                <dt class="col-sm-4">
                    Nombre
                </dt>
                <dd class="col-sm-8">
                    @evento.Nombre
                </dd>
                <dt class="col-sm-4">
                    Fecha
                </dt>
                <dd class="col-sm-8">
                    @evento.FechaInicio
                </dd>
            </dl>
        </div>
        <div class="col-md-6">
            <h3>Atleta</h3>
            <dl class="row">
                <dt class="col-sm-4">
                    Id
                </dt>
                <dd class="col-sm-8">
                    @atleta.Id
                </dd>
                <dt class="col-sm-4">
                    Nombre
                </dt>
                <dd class="col-sm-8">
                    @atleta.Nombre
                </dd>
                <dt class="col-sm-4">
                    Apellido
                </dt>
                <dd class="col-sm-8">
                    @atleta.Apellido
                </dd>
                <dt class="col-sm-4">
                    Pais
                </dt>
                <dd class="col-sm-8">
                    @atleta.Pais.Nombre
                </dd>
            </dl>
        </div>
    </div>
</div>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-danger" role="alert">
    @ViewBag.Mensaje
</div>
}

<form asp-action="Puntuar" asp-controller="Evento" method="post">
    <input type="hidden" asp-for="IdEvento" value="@evento.Id" />
    <input type="hidden" asp-for="IdAtleta" value="@atleta.Id" />
    <div class="form-row">
        <div class="form-group d-flex align-items-end">
            <div>
                <label asp-for="Puntaje">Puntaje</label>
                <input asp-for="Puntaje" class="form-control" type="number" step="any" min="0" />
                <span asp-validation-for="Puntaje" class="text-danger"></span>
            </div>
            <div>
                <button type="submit" class="btn btn-primary">Puntuar</button>
            </div>
        </div>
    </div>
</form>