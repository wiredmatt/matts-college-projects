@model IEnumerable<WebApp.Models.Eventos.ViewModelEventoListado>
@{
    ViewData["Title"] = "Buscar Eventos por Filtros";
    int? idDisciplina = ViewBag.IdDisciplina;
    DateOnly? fechaInicio = ViewBag.FechaInicio;
    DateOnly? fechaFin = ViewBag.FechaFin;
    string? nombreEvento = ViewBag.NombreEvento;
    double? puntajeMinimo = ViewBag.PuntajeMinimo;
    double? puntajeMaximo = ViewBag.PuntajeMaximo;
}

<h1>Buscar Eventos por Filtros</h1>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-info" role="alert">
    @ViewBag.Mensaje
</div>
}

<div class="alert alert-info" role="alert">
    Todos los campos son opcionales.
</div>

<form method="get" class="mb-4">
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">ID Disciplina</label>
            <input type="number" name="idDisciplina" class="form-control" value="@idDisciplina" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Fecha Inicio</label>
            <input type="date" name="fechaInicio" class="form-control" value="@fechaInicio?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Fecha Fin</label>
            <input type="date" name="fechaFin" class="form-control" value="@fechaFin?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Nombre Evento</label>
            <input type="text" name="nombreEvento" class="form-control" value="@nombreEvento" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Puntaje Mínimo</label>
            <input type="number" step="0.01" name="puntajeMinimo" class="form-control" value="@puntajeMinimo" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Puntaje Máximo</label>
            <input type="number" step="0.01" name="puntajeMaximo" class="form-control" value="@puntajeMaximo" />
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Disciplina</th>
            <th>Fecha Inicio</th>
            <th>Fecha Fin</th>
            <th>Cantidad de Participantes</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var evento in Model)
        {
            <tr>
                <td>@evento.Nombre</td>
                <td>@evento.Disciplina.Nombre</td>
                <td>@evento.FechaInicio.ToString()</td>
                <td>@evento.FechaFin.ToString()</td>
                <td>@evento.Atletas.Count()</td>
            </tr>
        }
    </tbody>
</table>
