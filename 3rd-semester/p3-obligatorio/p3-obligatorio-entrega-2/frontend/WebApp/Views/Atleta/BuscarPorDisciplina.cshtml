@model IEnumerable<WebApp.Models.Atletas.ViewModelAtletaListado>;

@{
    ViewData["Title"] = "Buscar Atletas por Disciplina";
    int? id = ViewBag.Id;
}

<h1>Buscar Atletas por Disciplina</h1>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-info" role="alert">
    @ViewBag.Mensaje
</div>
}

<form method="get">
    <div class="row align-items-center">
        <div class="form-group col-md-6 d-flex align-items-center">
            <label class="control-label me-2 mb-0">Id</label>
            <input class="form-control" type="number" name="id" value="@(id)" min="0" />
        </div>
        <div class="form-group col-md-6">
            <input type="submit" value="Buscar" class="btn btn-primary" />
        </div>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                Id
            </th>
            <th>
                Nombre
            </th>
            <th>
                Apellido
            </th>
            <th>
                Sexo
            </th>
            <th>
                Pais
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <strong>@item.Id</strong>
                </td>
                <td>
                    @item.Nombre
                </td>
                <td>
                    @item.Apellido
                </td>
                <td>
                    @item.Sexo
                </td>
                <td>
                    @item.Pais.Nombre
                </td>
            </tr>
        }
    </tbody>
</table>